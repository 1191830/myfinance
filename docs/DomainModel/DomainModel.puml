@startuml

' Define Enums
enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionFrequency {
  ONE_TIME
  RECURRING
}

' Define Classes
class User {
  +UUID id
  +String username
  +String passwordHash
  +Timestamp createdAt
}

class Transaction {
  +UUID id
  +TransactionType type
  +TransactionFrequency frequency
  +Decimal amount
  +Date date
  +String description
}

class RecurringTransaction {
  +UUID id
  +TransactionType type
  +TransactionFrequency frequency
  +RecurrenceInterval recurrenceInterval
  +Decimal amount
  +Date startDate
  +Date endDate
  +String description
  +Boolean active
}

class Category {
  +UUID id
  +String name
  +Decimal monthlyBudget
}

class Investment {
  +UUID id
  +String type
  +String ticker
  +Decimal amountInvested
  +Decimal currentValue
  +Date startDate
  +String notes
  +Timestamp lastSynced
}

class SavingGoal {
  +UUID id
  +String name
  +Decimal targetAmount
  +Decimal currentAmount
  +Date startDate
  +Date endDate
}

' Relationships
Transaction --> RecurringTransaction : recurring_id
Transaction --> Category : category_id
RecurringTransaction --> Category : category_id

' Every resource is owned by a user - each account's data is isolated from the others.
User --> Transaction : user_id
User --> RecurringTransaction : user_id
User --> Category : user_id
User --> Investment : user_id
User --> SavingGoal : user_id

@enduml
