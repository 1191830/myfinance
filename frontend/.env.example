# Copy to frontend/.env.local and adjust if the backend isn't on localhost:8080.
# Read at build time by Vite (import.meta.env.VITE_API_URL in src/config/axios.ts).
# On Vercel this is set as a project environment variable to the deployed backend's URL,
# e.g. https://<render-service>.onrender.com/api
VITE_API_URL=http://localhost:8080/api
