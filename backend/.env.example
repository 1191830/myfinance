# Copy to backend/.env  (cp backend/.env.example backend/.env) and adjust if needed.
# Loaded by config/EnvConfig + spring-dotenv, and by docker-compose.yml for the dev database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=personal_finance_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
# Signing key for login JWTs - any long random string. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-this-to-a-long-random-string
